@* DocumentPreviewDialog.razor – Inline preview panel for PDF and image documents *@

<FluentDialog Hidden="@Hidden" Modal="true" TrapFocus="true"
              AriaLabel="Document preview"
              Style="--dialog-width:min(80vw,960px)">
    <FluentDialogHeader>
        <FluentStack Gap="8" VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Icons.Regular.Size20.Eye())" />
            &nbsp;@(Document?.Name ?? "Preview")
        </FluentStack>
    </FluentDialogHeader>

    <FluentDialogBody>
        @if (Document is not null)
        {
            @if (Document.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            {
                <div style="text-align:center;padding:8px">
                    <img src="@Document.DownloadUrl"
                         alt="@Document.Name"
                         style="max-width:100%;max-height:70vh;object-fit:contain" />
                </div>
            }
            else if (string.Equals(Document.MimeType, "application/pdf",
                         StringComparison.OrdinalIgnoreCase))
            {
                <iframe src="@Document.DownloadUrl"
                        title="@Document.Name"
                        sandbox="allow-scripts allow-same-origin"
                        style="width:100%;height:70vh;border:none;display:block" />
            }
            else
            {
                <FluentStack Orientation="Orientation.Vertical" Gap="16"
                             HorizontalAlignment="HorizontalAlignment.Center"
                             Style="padding:48px;text-align:center">
                    <FluentIcon Value="@(new Icons.Regular.Size24.Document())"
                                Color="Color.Neutral" />
                    <FluentLabel>
                        In-browser preview is not available for
                        <b>@(string.IsNullOrEmpty(Document.MimeType) ? "this file type" : Document.MimeType)</b>.
                    </FluentLabel>
                    @if (!string.IsNullOrEmpty(Document.DownloadUrl))
                    {
                        <FluentAnchor Href="@Document.DownloadUrl" Target="_blank"
                                      Appearance="Appearance.Accent">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ArrowDownload())" />
                            &nbsp;Download to view
                        </FluentAnchor>
                    }
                </FluentStack>
            }
        }
    </FluentDialogBody>

    <FluentDialogFooter>
        @if (!string.IsNullOrEmpty(Document?.DownloadUrl))
        {
            <FluentAnchor Href="@Document.DownloadUrl" Target="_blank"
                          Appearance="Appearance.Lightweight">
                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowDownload())" />
                &nbsp;Download
            </FluentAnchor>
        }
        @if (!string.IsNullOrEmpty(Document?.WebUrl))
        {
            <FluentAnchor Href="@Document.WebUrl" Target="_blank"
                          Appearance="Appearance.Lightweight">
                <FluentIcon Value="@(new Icons.Regular.Size16.Open())" />
                &nbsp;Open in SharePoint
            </FluentAnchor>
        }
        <FluentButton Appearance="Appearance.Neutral" OnClick="OnClose">Close</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    /// <summary>The document to preview. Set to null to clear the preview.</summary>
    [Parameter, EditorRequired] public CaseDocument? Document { get; set; }

    /// <summary>When true the dialog is hidden.</summary>
    [Parameter] public bool Hidden { get; set; } = true;

    /// <summary>Invoked when the user clicks Close.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
}
