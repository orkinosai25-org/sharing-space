# ── Azure AD / Entra ID ───────────────────────────────────────────────────────
# Create an App Registration in https://entra.microsoft.com
# Grant application permissions: Sites.ReadWrite.All, Files.ReadWrite.All
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret

# ── SharePoint ────────────────────────────────────────────────────────────────
# Get the site ID via: GET https://graph.microsoft.com/v1.0/sites/{hostname}:/{path}
SHAREPOINT_SITE_ID=your-sharepoint-site-id
SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/LegalPortal
SHAREPOINT_TENANT_NAME=yourtenant

# ── Portal Branding ───────────────────────────────────────────────────────────
PORTAL_FIRM_NAME=Law Firm LLP
PORTAL_PRIMARY_COLOR=#0078D4
PORTAL_SUPPORT_EMAIL=it@lawfirm.com
